  "NOTES_DATA": [
    {
      "type": "info",
      "icon": "info",
      "title": "Custom Languages Blocked",
      "text": "Valve has blocked the use of custom languages (such as 123 or minify). Only official languages, such as russian, are now fully supported. If you want to use mods while playing with English dota, please use the fix created by <a href=\"https://github.com/Egezenn\"><span id=\"tg\">Egezenn</span></a>. You can download it <a href=\"https://github.com/Egezenn/dota2-minify-community/releases/download/_/English.Fix.zip\"><span id=\"tg\">here</span></a> - link to <a href=\"https://discord.com/invite/9867CPv7cy\"><span id=\"tg\">Minify Server</span></a>. Note: This fix requires <a href=\"https://github.com/Egezenn/dota2-minify/releases/Minify-v1.14rc5\"><span id=\"tg\">minify v1.14rc5</span></a> to function properly. All mods must be placed in the `dota_russian` folder, even if you want the English version of Dota."
    }
  ],
  "categoryNotes": {
    "item-effects": {
      "enabled": false,
      "text": "During events with custom effects (e.g. Quartero's Curios), some effects will not work. Use <a href=\"https://h6rd.github.io/Dota2PornFxWeb/?category=ti-bp-effects\"><span id=\"tg\">Effect Packs</span></a>."
    },
    "emblems": {
      "enabled": true,
      "text": "If emblem not working, try enter <code>r_draw_selected_ring 1</code> into the console. If this does not work, ensure that you are not using the Minify mod: Misc Optimization"
    }
  },
